{
    "version": "2.0.0",
    "tasks": [
        {
            // ★ 最常用：Ctrl+F5 → 编译 + 运行当前文件，输出显示在终端里
            "label": "运行当前文件",
            "type": "shell",
            "command": "\"D:\\My code\\tools\\run.cmd\"",
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "CURRENT_FILE": "${file}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": false,
                "focus": false
            },
            "problemMatcher": []
        },
        {
            // 只编译不运行：C 文件
            "label": "gcc 编译当前文件",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "-Wall",
                "-Wextra",
                "-static",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            // 只编译不运行：C++ 文件
            "label": "g++ 编译当前文件",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "-O2",
                "-Wall",
                "-Wextra",
                "-static",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}
