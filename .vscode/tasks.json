{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译当前文件（自动）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\build.ps1",
                "-Src",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": true,
                "focus": false
            }
        },
        {
            "label": "编译当前文件（调试）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\build.ps1",
                "-Src",
                "${file}",
                "-DebugBuild"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": true,
                "focus": false
            }
        },
        {
            "label": "运行当前文件",
            "type": "shell",
            "command": "\"${workspaceFolder}\\tools\\run.cmd\"",
            "args": [
                "/w"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "CURRENT_FILE": "${file}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": false,
                "focus": false
            },
            "problemMatcher": []
        },
        {
            "label": "运行当前文件（在终端里）",
            "type": "shell",
            "command": "\"${workspaceFolder}\\tools\\run.cmd\"",
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "CURRENT_FILE": "${file}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": false,
                "focus": false
            },
            "problemMatcher": []
        }
    ]
}